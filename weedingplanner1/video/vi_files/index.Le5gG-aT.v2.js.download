			precision highp float;

			varying vec2 vTexCoord;
			uniform sampler2D uTexture;
			uniform float uStepW;
			uniform float uStepH;

			uniform float uAmount;
			uniform float uGrainSize;
			uniform float uMonochrome;
			uniform float uLumaAmount;
			uniform float uChromaAmount;
			uniform float uShadowW;
			uniform float uMidW;
			uniform float uHighW;
			uniform float uOctaves;
			uniform float uSeed;

			highp float hash(highp vec2 p){
				// Use mod to keep intermediate values in reasonable range
				p = mod(p, vec2(1000.0));
				highp float h = dot(p, vec2(127.1, 311.7));
				return fract(sin(h) * 43758.5453123);
			}

			highp float noise(highp vec2 p){
				highp vec2 i = floor(p);
				highp vec2 f = fract(p);

				// Sample at 4 corners of the grid cell
				highp float a = hash(i);
				highp float b = hash(i + vec2(1.0, 0.0));
				highp float c = hash(i + vec2(0.0, 1.0));
				highp float d = hash(i + vec2(1.0, 1.0));

				// Smooth interpolation
				highp vec2 u = f * f * (3.0 - 2.0 * f);

				// Bilinear interpolation
				return mix(a, b, u.x) + (c - a) * u.y * (1.0 - u.x) + (d - b) * u.x * u.y;
			}

			highp float fbm(highp vec2 p, float oct){
				highp float v = 0.0;
				highp float amp = 0.5;
				highp vec2 shift = p;
				for (int i = 0; i < 6; i++){
					if(float(i) >= oct) break;
					v += amp * noise(shift);
					shift *= 2.0;
					amp *= 0.5;
				}
				return v;
			}

			void main(){
				vec4 color = texture2D(uTexture, vTexCoord);
				float Y = dot(color.rgb, vec3(0.299, 0.587, 0.114));

				float shadow = smoothstep(0.0, 0.5, 0.5 - Y);
				float highlight = smoothstep(0.0, 0.5, Y - 0.5);
				float mid = 1.0 - max(shadow, highlight);
				float tonal = shadow * uShadowW + mid * uMidW + highlight * uHighW;

				// Scale controls the frequency of the noise pattern
				// Use image dimensions to make grain size consistent across different image sizes
				highp float imageSize = max(1.0 / uStepW, 1.0 / uStepH);
				highp float scale = (imageSize * 0.5) / max(0.001, uGrainSize);

				highp float seedOffset = uSeed * 0.001;
				highp vec2 uv = vTexCoord * scale + vec2(seedOffset * 12.9898, seedOffset * 78.233);

				// Generate noise centered around 0.5, then shift to -0.5..0.5 range
				highp float gL = (fbm(uv, uOctaves) - 0.5);
				highp vec3 gC = vec3(
					fbm(uv + vec2(13.1, 7.2), uOctaves) - 0.5,
					fbm(uv + vec2(37.7, 23.4), uOctaves) - 0.5,
					fbm(uv + vec2(73.3, 41.5), uOctaves) - 0.5
				);

				// Apply grain with proper scaling
				float lumaDelta = uAmount * uLumaAmount * tonal * gL;
				vec3 chromaDelta = uAmount * uChromaAmount * tonal * gC;

				vec3 grainEffect = uMonochrome > 0.5 ? vec3(lumaDelta) : vec3(lumaDelta) + chromaDelta;
				vec3 outRgb = color.rgb + grainEffect;

				gl_FragColor = vec4(clamp(outRgb, 0.0, 1.0), color.a);
			}
		`,toObject:function(){return Ma.util.object.extend(this.callSuper("toObject"),{amount:this.amount,grainSize:this.grainSize,monochrome:!!this.monochrome,lumaAmount:this.lumaAmount,chromaAmount:this.chromaAmount,shadowWeight:this.shadowWeight,midWeight:this.midWeight,highlightWeight:this.highlightWeight,octaves:this.octaves,seed:this.seed})}}),useAppEvents=createSharedComposable(()=>({emitAppEvent:(Ha,Wa={})=>{var Ka,rl;(Ka=window.FreepikApp)===null||Ka===void 0||Ka.onEventReceived(Ha,JSON.stringify(Wa)),(rl=window.webkit)===null||rl===void 0||(rl=rl.messageHandlers)===null||rl===void 0||(rl=rl.FreepikApp)===null||rl===void 0||rl.postMessage({event:Ha,data:Wa})}})),useLangSelector=createSharedComposable(()=>{const{i18next:Ma}=useTranslation(),{DEV:Ha}=env;function Wa(sl,il){const ul=new URL(sl),cl=il==="es_ES"?"es":"com",dl=getSubdomainFromLocale(il),pl=ul.hostname.split(".");return pl.length>=2&&(pl[pl.length-1]=cl,dl&&pl.length>=3&&(pl[0]=dl),ul.hostname=pl.join(".")),Ha&&ul.searchParams.set("lang",il),ul.toString()}function Ka(sl){if(sl===Ma.language||!ALLOWED_LOCALES.includes(sl))return;const il=Wa(window.location.href,sl);window.location.assign(il)}function rl(sl){if(!sl.includes("freepik."))return sl;const il=Ma.language;return ALLOWED_LOCALES.includes(il)?Wa(sl,il):sl}return{changeLang:Ka,getUrlForCurrentLang:rl}}),LINK_ID="#from-element=dropdown_menu-pikaso",ACCOUNT_LINK="/user/me",MY_SUBSCRIPTIONS_LINK$1="/user/my-subscriptions",MY_COLLECTIONS_LINK="/user/collections",USER_LINKS_V2=[{href:MY_SUBSCRIPTIONS_LINK$1,icon:"card",name:"user.userMenu.subscription",dataCy:"popover-user-my-subscription"},{href:MY_SUBSCRIPTIONS_LINK$1,icon:"card",name:"user.userMenu.planAndBilling",dataCy:"popover-user-my-subscription"},{href:ACCOUNT_LINK,icon:"user",name:"user.userMenu.account",dataCy:"popover-account"},{href:ACCOUNT_LINK,icon:"settings",name:"user.userMenu.settings",dataCy:"popover-account"},{icon:"globe",name:"user.userMenu.creatorProfile",dataCy:"creatorProfile"}